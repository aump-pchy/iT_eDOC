# ============================================================
# iT-e-Document · Backend Environment Variables (Production)
# ============================================================

# Server
PORT=3000

# Frontend URL (for CORS) - ชี้ไปยัง IP ของเซิร์ฟเวอร์วิทยาลัย และระบุพอร์ตใหม่
FRONTEND_URL=http://192.168.10.201:8000

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=itedoc
DB_USER=itedoc
DB_PASSWORD=secret

# ── MinIO (S3-compatible file storage) ───────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=memos-pdf
# IP ของเซิร์ฟเวอร์วิทยาลัย สำหรับเรียกดูไฟล์ PDF ในเบราว์เซอร์
MINIO_PUBLIC_HOST=192.168.10.201
MINIO_PUBLIC_PORT=8000

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=iT-e-DOC@LoeiTech#2569!SecretKey
JWT_EXPIRES_IN=7d