# ============================================================
# iT-e-Document · Backend Environment (Example)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามการ deploy จริง
# ============================================================

# Server
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=itedoc
DB_USER=itedoc
DB_PASSWORD=your_strong_password_here

# ── MinIO (S3-compatible file storage) ───────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here
MINIO_BUCKET=memos-pdf
# ถ้า deploy บน server ให้เปลี่ยนเป็น IP หรือ domain จริง
MINIO_PUBLIC_HOST=localhost
MINIO_PUBLIC_PORT=9000

# ── JWT ──────────────────────────────────────────────────────
# ตั้งเป็นคำอะไรก็ได้ ยาวๆ เดายากๆ
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
